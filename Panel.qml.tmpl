// Generated by mazapan (plugin {{ plugin }}).
//
// Radio: on the left, what to listen to (moods first, then yours: the
// favorites, the recent stations, the songs heard; then where: near you,
// the whole world by country). On top, what's on: the song's cover big over
// its own blurred light (the station's logo when the station sends none),
// the song, the station and its flag, live, the sound drawn, the buttons, a
// sleep timer and an alarm. Below, the stations as cards.
//
// / searches, ↑ ↓ ← → move through the cards, Enter plays, Space plays or
// pauses, F keeps a favorite, N and P go to the next and previous station,
// Esc clears the search or closes; so does a click outside.

import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as QQC
import QtQuick.Effects
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/radio"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property var rd: Radio

  // What the list shows: "mood:<key>", "favorites", "recent", "heard",
  // "near", "countries", "country:<CC>", "search", "popular".
  property string view: ""
  property string viewTitle: ""
  readonly property var shown: view === "favorites" ? rd.favorites : view === "recent" ? rd.recent : rd.results

  readonly property var moods: [
    { key: "focus", tag: "ambient", label: {{ tq "mood.focus" }}, hue: 0.58 },
    { key: "chill", tag: "chillout", label: {{ tq "mood.chill" }}, hue: 0.48 },
    { key: "lofi", tag: "lofi", label: {{ tq "mood.lofi" }}, hue: 0.78 },
    { key: "jazz", tag: "jazz", label: {{ tq "mood.jazz" }}, hue: 0.08 },
    { key: "classical", tag: "classical", label: {{ tq "mood.classical" }}, hue: 0.13 },
    { key: "electronic", tag: "electronic", label: {{ tq "mood.electronic" }}, hue: 0.86 },
    { key: "rock", tag: "rock", label: {{ tq "mood.rock" }}, hue: 0.0 },
    { key: "hiphop", tag: "hiphop", label: {{ tq "mood.hiphop" }}, hue: 0.94 },
    { key: "pop", tag: "pop", label: {{ tq "mood.pop" }}, hue: 0.9 },
    { key: "latin", tag: "latin", label: {{ tq "mood.latin" }}, hue: 0.04 },
    { key: "soul", tag: "soul", label: {{ tq "mood.soul" }}, hue: 0.7 },
    { key: "news", tag: "news", label: {{ tq "mood.news" }}, hue: 0.35 },
  ]

  function go(v, title) {
    view = v
    viewTitle = title
    if (v.startsWith("mood:")) {
      const m = moods.find(x => "mood:" + x.key === v)
      rd.browse("tag", m.tag)
    } else if (v === "near") rd.browse("country", rd.home_country)
    else if (v.startsWith("country:")) rd.browse("country", v.slice(8))
    else if (v === "popular") rd.browse("top", "")
    else if (v === "countries") rd.loadCountries()
    grid.currentIndex = -1
  }

  // The left column in order, for Tab and Shift+Tab.
  readonly property var places: moods.map(m => ["mood:" + m.key, m.label]).concat([
    ["popular", {{ tq "popular" }}], ["favorites", {{ tq "favorites" }}], ["recent", {{ tq "recent" }}],
    ["heard", {{ tq "heard" }}], ["near", {{ tq "near" }}], ["countries", {{ tq "world" }}]])
  function step(d) {
    const i = places.findIndex(p => p[0] === view)
    const p = places[(i + d + places.length) % places.length]
    go(p[0], p[1])
  }

  // After a search, the first result is picked once it's there.
  property bool pickFirst: false
  Connections {
    target: Radio
    function onResultsChanged() {
      if (root.pickFirst && Radio.results.length) { grid.currentIndex = 0; root.pickFirst = false }
    }
  }

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    if (!view) go("popular", {{ tq "popular" }})
    Qt.callLater(() => sink.forceActiveFocus())
  }
  function close() { open = false }

  Binding { target: Radio; property: "panelOpen"; value: root.open }

  PanelWindow {
    id: win
    visible: root.open || card.opacity > 0.01
    screen: root.screenAtOpen
    anchors.top: true
    anchors.bottom: true
    anchors.left: true
    anchors.right: true
    color: "transparent"
    exclusionMode: ExclusionMode.Normal
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-radio"
    WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    mask: Region { item: root.open ? win.contentItem : null }

    // A click anywhere else closes it.
    MouseArea {
      anchors.fill: parent
      enabled: root.open
      acceptedButtons: Qt.AllButtons
      onPressed: root.close()
    }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(parent.width - 48, 1120)
      height: Math.min(parent.height - 48, 720)
      color: Theme.bg
      border.width: 1
      border.color: Theme.border
      radius: Theme.radius
      clip: true

      opacity: root.open ? 1 : 0
      scale: root.open ? 1 : 0.97
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
      Behavior on scale { enabled: Theme.motion; NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }

      MouseArea { anchors.fill: parent; acceptedButtons: Qt.AllButtons }

      FocusScope {
        id: keys
        anchors.fill: parent
        focus: true
        Keys.onPressed: event => {
          const typing = search.activeFocus
          if (event.key === Qt.Key_Escape) {
            if (typing && search.text) search.text = ""
            else if (typing) sink.forceActiveFocus()
            else root.close()
          } else if (typing) {
            return
          } else if (event.key === Qt.Key_Slash) search.focusInput()
          else if (event.key === Qt.Key_Tab) root.step(1)
          else if (event.key === Qt.Key_Backtab) root.step(-1)
          else if (event.key === Qt.Key_Space) rd.toggle()
          else if (event.key === Qt.Key_N) rd.next()
          else if (event.key === Qt.Key_P) rd.previous()
          else if (event.key === Qt.Key_F && grid.currentIndex >= 0) rd.favorite(root.shown[grid.currentIndex])
          else if (event.key === Qt.Key_F && rd.station) rd.favorite(rd.station)
          else if ((event.key === Qt.Key_Return || event.key === Qt.Key_Enter) && grid.currentIndex >= 0)
            rd.play(root.shown[grid.currentIndex], root.shown)
          else if ([Qt.Key_Left, Qt.Key_Right, Qt.Key_Up, Qt.Key_Down].includes(event.key) && grid.visible) {
            if (grid.currentIndex < 0) grid.currentIndex = 0
            else if (event.key === Qt.Key_Left) grid.moveCurrentIndexLeft()
            else if (event.key === Qt.Key_Right) grid.moveCurrentIndexRight()
            else if (event.key === Qt.Key_Up) grid.moveCurrentIndexUp()
            else grid.moveCurrentIndexDown()
          } else return
          event.accepted = true
        }

        // Where the keys go when nothing is typed: always there, whichever
        // list is shown; what it doesn't take, the handler above does.
        Item { id: sink; focus: true }

        RowLayout {
          anchors.fill: parent
          spacing: 0

          // --- what to listen to -------------------------------------------------------------
          Rectangle {
            Layout.preferredWidth: 236
            Layout.fillHeight: true
            color: Theme.bgAlt

            Flickable {
              anchors.fill: parent
              anchors.margins: 14
              contentHeight: side.implicitHeight
              clip: true
              boundsBehavior: Flickable.StopAtBounds

              ColumnLayout {
                id: side
                width: parent.width
                spacing: 2

                RowLayout {
                  spacing: 10
                  Layout.bottomMargin: 14
                  Rectangle {
                    width: 30
                    height: 30
                    radius: Theme.radius > 0 ? 15 : 0
                    color: Theme.accent
                    Text {
                      anchors.centerIn: parent
                      text: "󰐹"
                      color: Theme.accentFg
                      font.family: Theme.fontMono
                      font.pixelSize: 16
                    }
                    SequentialAnimation on scale {
                      running: rd.playing && Theme.motion
                      loops: Animation.Infinite
                      NumberAnimation { to: 1.08; duration: 900; easing.type: Easing.InOutSine }
                      NumberAnimation { to: 1.0; duration: 900; easing.type: Easing.InOutSine }
                    }
                  }
                  Text {
                    text: {{ tq "title" }}
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pixelSize: Theme.fontSize * 1.7
                    font.bold: true
                  }
                }

                Caption { text: {{ tq "listen" }}; Layout.topMargin: 4; Layout.bottomMargin: 4 }
                Repeater {
                  model: root.moods
                  SideRow {
                    required property var modelData
                    Layout.fillWidth: true
                    label: modelData.label
                    swatch: Qt.hsla(modelData.hue, 0.6, 0.55, 1)
                    current: root.view === "mood:" + modelData.key
                    onClicked: root.go("mood:" + modelData.key, modelData.label)
                  }
                }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "popular" }}
                  glyph: "󰈸"
                  current: root.view === "popular"
                  onClicked: root.go("popular", label)
                }

                Caption { text: {{ tq "yours" }}; Layout.topMargin: 14; Layout.bottomMargin: 4 }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "favorites" }}
                  glyph: "★"
                  count: rd.favorites.length
                  current: root.view === "favorites"
                  onClicked: root.go("favorites", label)
                }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "recent" }}
                  glyph: "󰋚"
                  count: rd.recent.length
                  current: root.view === "recent"
                  onClicked: root.go("recent", label)
                }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "heard" }}
                  glyph: "󰎈"
                  count: rd.heard.length
                  current: root.view === "heard"
                  onClicked: root.go("heard", label)
                }

                Caption { text: {{ tq "where" }}; Layout.topMargin: 14; Layout.bottomMargin: 4 }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "near" }}
                  glyph: rd.flag(rd.home_country)
                  current: root.view === "near"
                  onClicked: root.go("near", label)
                }
                SideRow {
                  Layout.fillWidth: true
                  label: {{ tq "world" }}
                  glyph: "󰖟"
                  current: root.view === "countries" || root.view.startsWith("country:")
                  onClicked: root.go("countries", label)
                }
              }
            }
          }

          Rectangle { Layout.fillHeight: true; Layout.preferredWidth: 1; color: Theme.border }

          // --- what's on, and the stations ----------------------------------------------------
          ColumnLayout {
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 0

            // The top: search, sleep, alarm.
            RowLayout {
              Layout.fillWidth: true
              Layout.margins: 14
              spacing: 10
              TextField {
                id: search
                Layout.fillWidth: true
                placeholder: {{ tq "search" }}
                // Enter: the results take the keys, the first one picked.
                onAccepted: if (text.trim()) {
                  root.view = "search"
                  root.viewTitle = "“" + text.trim() + "”"
                  rd.browse("search", text.trim())
                  root.pickFirst = true
                  sink.forceActiveFocus()
                }
              }
              PillButton {
                glyph: "󰒲"
                text: rd.sleepAt ? Math.max(1, Math.ceil((rd.sleepAt - clock.now) / 60)) + " min" : {{ tq "sleep" }}
                on: rd.sleepAt > 0
                onClicked: {
                  const left = rd.sleepAt ? Math.ceil((rd.sleepAt - clock.now) / 60) : 0
                  const steps = [15, 30, 60, 90]
                  const next = steps.find(s => s > left + 1)
                  rd.sleepFor(next ?? 0)
                }
              }
              PillButton {
                glyph: "󰀠"
                text: rd.alarm || {{ tq "alarm" }}
                on: rd.alarm !== ""
                onClicked: alarmBox.visible = !alarmBox.visible
              }
            }

            // The alarm, set in place.
            RowLayout {
              id: alarmBox
              visible: false
              Layout.fillWidth: true
              Layout.leftMargin: 14
              Layout.rightMargin: 14
              Layout.bottomMargin: 10
              spacing: 10
              Label { text: {{ tq "alarm.ask" }}; color: Theme.fgMuted }
              TextField {
                id: alarmAt
                Layout.preferredWidth: 90
                placeholder: "07:00"
                text: rd.alarm
                onAccepted: {
                  if (/^([01]?\d|2[0-3]):[0-5]\d$/.test(text.trim())) { rd.setAlarm(text.trim()); alarmBox.visible = false }
                }
              }
              Button { text: {{ tq "alarm.set" }}; primary: true; onClicked: alarmAt.accepted() }
              Button { text: {{ tq "alarm.off" }}; visible: rd.alarm !== ""; onClicked: { rd.setAlarm(""); alarmBox.visible = false } }
              Item { Layout.fillWidth: true }
            }

            Hero {
              Layout.fillWidth: true
              Layout.leftMargin: 14
              Layout.rightMargin: 14
              Layout.preferredHeight: 214
            }

            // The list's heading.
            RowLayout {
              Layout.fillWidth: true
              Layout.margins: 14
              Layout.bottomMargin: 4
              spacing: 10
              Text {
                text: root.viewTitle
                color: Theme.fg
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 1.45
                font.bold: true
              }
              Caption {
                visible: root.view !== "countries" && root.view !== "heard"
                text: rd.loading ? {{ tq "loading" }} : {{ tq "stations" }}.arg(root.shown.length)
                font.letterSpacing: 0
              }
              Caption {
                visible: rd.problem !== "" && !["favorites", "recent", "heard"].includes(root.view)
                text: {{ tq "offline" }}
                color: Theme.warning
                font.letterSpacing: 0
              }
              Item { Layout.fillWidth: true }
              Button {
                visible: root.view === "heard" && rd.heard.length > 0
                text: {{ tq "forget" }}
                onClicked: rd.forgetHeard()
              }
            }

            // --- the stations, as cards ---
            GridView {
              id: grid
              Layout.fillWidth: true
              Layout.fillHeight: true
              Layout.leftMargin: 10
              Layout.rightMargin: 10
              visible: !["countries", "heard"].includes(root.view)
              clip: true
              cellWidth: Math.floor(width / Math.max(1, Math.floor(width / 290)))
              cellHeight: 92
              model: root.shown
              currentIndex: -1
              boundsBehavior: Flickable.StopAtBounds
              QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }
              delegate: StationCard {
                required property var modelData
                required property int index
                width: grid.cellWidth
                height: grid.cellHeight
                station: modelData
                order: index
                selected: GridView.isCurrentItem
                onPlay: rd.play(modelData, root.shown)
              }
              // Nothing to show.
              Text {
                anchors.centerIn: parent
                visible: !rd.loading && root.shown.length === 0
                text: root.view === "favorites" ? {{ tq "empty.favorites" }} : root.view === "recent" ? {{ tq "empty.recent" }} : {{ tq "empty" }}
                color: Theme.fgMuted
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 1.15
                horizontalAlignment: Text.AlignHCenter
              }
            }

            // --- every country ---
            GridView {
              id: countryGrid
              Layout.fillWidth: true
              Layout.fillHeight: true
              Layout.leftMargin: 10
              Layout.rightMargin: 10
              visible: root.view === "countries"
              clip: true
              cellWidth: Math.floor(width / Math.max(1, Math.floor(width / 210)))
              cellHeight: 44
              model: rd.countries
              boundsBehavior: Flickable.StopAtBounds
              QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }
              delegate: Item {
                required property var modelData
                width: countryGrid.cellWidth
                height: countryGrid.cellHeight
                Rectangle {
                  anchors.fill: parent
                  anchors.margins: 3
                  radius: Theme.radius
                  color: hoverC.hovered ? Theme.surfaceRaised : Theme.surface
                  border.width: 1
                  border.color: hoverC.hovered ? Qt.alpha(Theme.accent, 0.55) : Theme.border
                  RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 10
                    anchors.rightMargin: 10
                    spacing: 8
                    Text { text: rd.flag(modelData.code); font.pixelSize: Theme.fontSize * 1.5 }
                    Text {
                      Layout.fillWidth: true
                      text: modelData.name
                      color: Theme.fg
                      elide: Text.ElideRight
                      font.family: Theme.fontMono
                      font.pixelSize: Theme.fontSize * 1.05
                      textFormat: Text.PlainText
                    }
                    Caption { text: modelData.count; font.letterSpacing: 0 }
                  }
                  HoverHandler { id: hoverC; cursorShape: Qt.PointingHandCursor }
                  TapHandler { onTapped: root.go("country:" + modelData.code, rd.flag(modelData.code) + "  " + modelData.name) }
                }
              }
            }

            // --- the songs heard ---
            ListView {
              id: heardList
              Layout.fillWidth: true
              Layout.fillHeight: true
              Layout.leftMargin: 14
              Layout.rightMargin: 14
              visible: root.view === "heard"
              clip: true
              spacing: 6
              model: rd.heard
              boundsBehavior: Flickable.StopAtBounds
              QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }
              delegate: HeardRow {
                required property var modelData
                width: heardList.width
                song: modelData
              }
              Text {
                anchors.centerIn: parent
                visible: rd.heard.length === 0
                text: {{ tq "empty.heard" }}
                color: Theme.fgMuted
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 1.15
                horizontalAlignment: Text.AlignHCenter
              }
            }

            Caption {
              Layout.fillWidth: true
              Layout.margins: 10
              text: {{ tq "keys" }}
              font.letterSpacing: 0
              color: Theme.fgSubtle
              horizontalAlignment: Text.AlignHCenter
              elide: Text.ElideRight
            }
          }
        }
      }
    }
  }

  // The sleep timer's minutes, counting down.
  QtObject {
    id: clock
    property real now: Date.now() / 1000
  }
  Timer {
    interval: 1000
    repeat: true
    running: root.open && rd.sleepAt > 0
    onTriggered: clock.now = Date.now() / 1000
  }

  // --- pieces of this panel ----------------------------------------------------------------

  // A row of the left column.
  component SideRow: Item {
    id: row
    property string label: ""
    property string glyph: ""
    property color swatch: "transparent"
    property int count: -1
    property bool current: false
    signal clicked()
    implicitHeight: 32
    Rectangle {
      anchors.fill: parent
      radius: Theme.radius
      color: row.current ? Theme.selection : rowHover.hovered ? Qt.alpha(Theme.fg, 0.06) : "transparent"
      Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 140 } }
      Rectangle {
        visible: row.current
        width: 3
        height: parent.height - 12
        anchors.verticalCenter: parent.verticalCenter
        color: Theme.accent
        radius: 1.5
      }
    }
    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 12
      anchors.rightMargin: 10
      spacing: 10
      Item {
        Layout.preferredWidth: 16
        Layout.preferredHeight: 16
        Rectangle {
          anchors.centerIn: parent
          visible: row.glyph === ""
          width: 12
          height: 12
          radius: Theme.radius > 0 ? 6 : 2
          gradient: Gradient {
            GradientStop { position: 0; color: Qt.lighter(row.swatch, 1.25) }
            GradientStop { position: 1; color: Qt.darker(row.swatch, 1.2) }
          }
          scale: row.current ? 1.2 : 1
          Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 4; damping: 0.3 } }
        }
        Text {
          anchors.centerIn: parent
          visible: row.glyph !== ""
          text: row.glyph
          color: row.current ? Theme.accentText : Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: 14
        }
      }
      Text {
        Layout.fillWidth: true
        text: row.label
        color: row.current ? Theme.fg : Theme.fgMuted
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 1.15
        font.bold: row.current
        elide: Text.ElideRight
      }
      Caption { visible: row.count > 0; text: row.count; font.letterSpacing: 0 }
    }
    HoverHandler { id: rowHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: row.clicked() }
  }

  // A button with a glyph and a word, lit when on.
  component PillButton: Rectangle {
    id: pill
    property string glyph: ""
    property string text: ""
    property bool on: false
    signal clicked()
    implicitHeight: 34
    implicitWidth: pillRow.implicitWidth + 24
    radius: Theme.radius
    color: pill.on ? Qt.alpha(Theme.accent, 0.18) : pillHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: pill.on ? Theme.accent : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 140 } }
    Row {
      id: pillRow
      anchors.centerIn: parent
      spacing: 7
      Text { text: pill.glyph; color: pill.on ? Theme.accentText : Theme.fgMuted; font.family: Theme.fontMono; font.pixelSize: 14; anchors.verticalCenter: parent.verticalCenter }
      Text { text: pill.text; color: pill.on ? Theme.accentText : Theme.fg; font.family: Theme.fontMono; font.pixelSize: Theme.fontSize * 1.05; anchors.verticalCenter: parent.verticalCenter }
    }
    HoverHandler { id: pillHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: pill.clicked() }
  }

  // What's on: the song's cover over its blurred light, the station, the buttons, the sound.
  component Hero: Rectangle {
    id: hero
    radius: Theme.radius
    color: Theme.surface
    border.width: 1
    border.color: Theme.border
    clip: true

    readonly property var st: Radio.station
    readonly property string picture: Radio.art || (st && (st.favicon || "").startsWith("https://") ? st.favicon : "")

    Backdrop {
      anchors.fill: parent
      visible: !!hero.st
      source: hero.picture
      wash: Qt.hsla(hero.st ? Radio.hue(hero.st.name) : 0.6, 0.4, Theme.mode === "light" ? 0.88 : 0.16, 1)
      base: Theme.surface
      strength: Radio.art ? 0.7 : 0.4
    }

    // Nothing on yet: an invitation.
    ColumnLayout {
      anchors.centerIn: parent
      visible: !hero.st
      spacing: 8
      Text {
        Layout.alignment: Qt.AlignHCenter
        text: {{ tq "welcome" }}
        color: Theme.fg
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 2
        font.bold: true
      }
      Text {
        Layout.alignment: Qt.AlignHCenter
        text: {{ tq "welcome.more" }}
        color: Theme.fgMuted
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 1.15
      }
    }

    RowLayout {
      anchors.fill: parent
      anchors.margins: 18
      spacing: 20
      visible: !!hero.st

      Item {
        Layout.preferredWidth: 178
        Layout.preferredHeight: 178
        RectangularShadow {
          anchors.fill: logoBig
          radius: logoBig.radius
          blur: 26
          offset.y: 8
          color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.25 : 0.5)
        }
        Logo {
          id: logoBig
          anchors.fill: parent
          source: hero.st ? hero.st.favicon || "" : ""
          cover: Radio.art
          name: hero.st ? hero.st.name : ""
          radius: Math.min(Theme.radius * 2, 14)
          scale: Radio.playing ? 1 : 0.92
          Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 2.6; damping: 0.28; epsilon: 0.001 } }
        }
      }

      ColumnLayout {
        Layout.fillWidth: true
        Layout.fillHeight: true
        spacing: 6

        // Live, or what it's doing.
        Row {
          spacing: 8
          Rectangle {
            anchors.verticalCenter: parent.verticalCenter
            width: liveText.implicitWidth + 18
            height: 20
            radius: Theme.radius > 0 ? 10 : 0
            color: Radio.status === "error" ? Theme.danger : Radio.playing ? Theme.accent : Qt.alpha(Theme.fg, 0.15)
            Row {
              anchors.centerIn: parent
              spacing: 5
              Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: 6
                height: 6
                radius: 3
                color: Radio.playing ? Theme.accentFg : Theme.fg
                SequentialAnimation on opacity {
                  running: (Radio.playing || Radio.connecting) && Theme.motion
                  loops: Animation.Infinite
                  NumberAnimation { to: 0.25; duration: 700 }
                  NumberAnimation { to: 1; duration: 700 }
                }
              }
              Text {
                id: liveText
                text: Radio.connecting ? {{ tq "tuning" }} : Radio.playing ? {{ tq "live" }} : Radio.status === "paused" ? {{ tq "paused" }}
                  : Radio.status === "error" ? {{ tq "failed" }} : {{ tq "stopped" }}
                color: Radio.playing ? Theme.accentFg : Theme.fg
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 0.95
                font.bold: true
              }
            }
          }
          Text {
            anchors.verticalCenter: parent.verticalCenter
            text: hero.st ? Radio.flag(hero.st.countrycode) + "  " + hero.st.name : ""
            color: Theme.fg
            font.family: Theme.fontMono
            font.pixelSize: Theme.fontSize * 1.15
            textFormat: Text.PlainText
          }
        }

        TrackText {
          Layout.fillWidth: true
          Layout.topMargin: 4
          text: Radio.song ? Radio.song.title : hero.st ? hero.st.name : ""
          bold: true
          family: Theme.fontMono
          pixelSize: Theme.fontSize * 2.1
        }
        TrackText {
          Layout.fillWidth: true
          delay: 70
          text: Radio.status === "error" ? Radio.error : Radio.song ? (Radio.song.artist || "") : Radio.tags(hero.st || {}, 4).join(" · ")
          color: Radio.status === "error" ? Theme.danger : Theme.accentText
          family: Theme.fontMono
          pixelSize: Theme.fontSize * 1.35
        }

        Item { Layout.fillHeight: true }

        Bars {
          Layout.fillWidth: true
          Layout.preferredHeight: 30
          count: 64
          levels: Radio.levels
          breathing: Radio.levels.length === 0
          playing: Radio.playing
          tint: Theme.accent
          opacity: 0.9
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 10
          Control { glyph: "󰒮"; size: 36; enabled: Radio.now.canNext === true; onClicked: Radio.previous() }
          Control {
            glyph: Radio.playing || Radio.connecting ? "󰏤" : "󰐊"
            size: 46
            filled: true
            tint: Theme.accent
            ink: Theme.accentFg
            onClicked: Radio.toggle()
          }
          Control { glyph: "󰒭"; size: 36; enabled: Radio.now.canNext === true; onClicked: Radio.next() }
          Control { glyph: "󰓛"; size: 36; enabled: Radio.active; onClicked: Radio.stop() }
          Control {
            glyph: Radio.isFavorite(hero.st) ? "★" : "☆"
            size: 36
            on: Radio.isFavorite(hero.st)
            tint: Theme.warning
            onClicked: Radio.favorite(hero.st)
          }
          Item { Layout.fillWidth: true }
          Text { text: "󰕾"; color: Theme.fgMuted; font.family: Theme.fontMono; font.pixelSize: 15 }
          Seek {
            Layout.preferredWidth: 150
            value: Radio.volume
            tint: Theme.fg
            thin: 4
            thick: 7
            onMoved: fraction => Radio.setVolume(fraction)
          }
        }
      }
    }
  }

  // A song heard: its cover, what and who, where and when; copy it, find it.
  component HeardRow: Rectangle {
    id: hr
    property var song: ({})
    implicitHeight: 58
    radius: Theme.radius
    color: hrHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: Theme.border
    RowLayout {
      anchors.fill: parent
      anchors.margins: 8
      spacing: 12
      Logo {
        Layout.preferredWidth: 42
        Layout.preferredHeight: 42
        cover: hr.song.art || ""
        name: hr.song.artist || hr.song.title || ""
        radius: Math.min(Theme.radius, 6)
      }
      ColumnLayout {
        Layout.fillWidth: true
        spacing: 2
        Text {
          Layout.fillWidth: true
          text: hr.song.title || ""
          color: Theme.fg
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 1.15
          font.bold: true
          elide: Text.ElideRight
          textFormat: Text.PlainText
        }
        Text {
          Layout.fillWidth: true
          text: [hr.song.artist, Radio.flag(hr.song.countrycode) + " " + (hr.song.station || ""), Radio.ago(hr.song.at)].filter(s => s && s.trim()).join("  ·  ")
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.98
          elide: Text.ElideRight
          textFormat: Text.PlainText
        }
      }
      readonly property string query: [hr.song.artist, hr.song.title].filter(s => s).join(" ")
      Button { text: {{ tq "copy" }}; onClicked: Quickshell.execDetached(["wl-copy", "--", parent.query]) }
      Button { text: "YouTube"; onClicked: Quickshell.execDetached(["xdg-open", "https://www.youtube.com/results?search_query=" + encodeURIComponent(parent.query)]) }
      Button { text: "Spotify"; onClicked: Quickshell.execDetached(["xdg-open", "https://open.spotify.com/search/" + encodeURIComponent(parent.query)]) }
    }
    HoverHandler { id: hrHover }
  }
}
