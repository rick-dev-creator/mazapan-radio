// Generated by mazapan (plugin {{ plugin }}): a line of text that, when it
// doesn't fit, glides along after a pause, its ends fading out.

import QtQuick
import QtQuick.Effects
import qs

Item {
  id: m

  property string text: ""
  property color color: Theme.fg
  property real pixelSize: Theme.fontSize * 1.33
  property bool bold: false
  property string family: Theme.fontUi
  // Glides only while true (a bar's title: on hover).
  property bool running: true

  readonly property bool overflow: line.implicitWidth > width + 1
  readonly property real gap: 40

  implicitWidth: line.implicitWidth
  implicitHeight: line.implicitHeight
  clip: true

  layer.enabled: overflow
  layer.effect: MultiEffect {
    maskEnabled: true
    maskSource: fade
    maskThresholdMin: 0
    maskSpreadAtMin: 1
  }

  Row {
    id: strip
    spacing: m.gap
    Text {
      id: line
      text: m.text
      color: m.color
      font.family: m.family
      font.pixelSize: m.pixelSize
      font.bold: m.bold
      Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 400 } }
    }
    Text {
      visible: m.overflow
      text: m.text
      color: m.color
      font: line.font
    }
  }

  SequentialAnimation {
    id: glide
    running: m.overflow && m.running && Theme.motion && m.visible
    loops: Animation.Infinite
    PauseAnimation { duration: 2200 }
    NumberAnimation {
      target: strip
      property: "x"
      from: 0
      to: -(line.implicitWidth + m.gap)
      duration: (line.implicitWidth + m.gap) * 28
      easing.type: Easing.InOutSine
    }
    PropertyAction { target: strip; property: "x"; value: 0 }
  }
  onTextChanged: { strip.x = 0; if (glide.running) glide.restart() }
  onRunningChanged: if (!running) strip.x = 0

  Rectangle {
    id: fade
    anchors.fill: parent
    visible: false
    layer.enabled: true
    gradient: Gradient {
      orientation: Gradient.Horizontal
      GradientStop { position: 0; color: strip.x < 0 ? "transparent" : "white" }
      GradientStop { position: 0.06; color: "white" }
      GradientStop { position: 0.9; color: "white" }
      GradientStop { position: 1; color: "transparent" }
    }
  }
}
