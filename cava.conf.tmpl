# Generated by mazapan (plugin {{ plugin }}): cava, listening to what goes
# out, its bars as numbers on its output for the shell to draw.
[general]
bars = 32
framerate = 60
autosens = 1

[input]
method = pipewire
source = auto

[output]
method = raw
channels = mono
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
monstercat = 1
noise_reduction = 66
