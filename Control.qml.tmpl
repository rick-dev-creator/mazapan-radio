// Generated by mazapan (plugin {{ plugin }}): a button of the player.
//
// A glyph that lights under the pointer and gives under the press, with a
// spring; `filled` (play), in the cover's color; `on` (shuffle, repeat), a
// dot beneath. A new glyph (play to pause) pops in.

import QtQuick
import qs

Item {
  id: c

  property string glyph: ""
  property real size: 36
  property bool filled: false
  property bool on: false
  property color tint: Theme.accent
  property color ink: Theme.bg
  signal clicked()

  implicitWidth: size
  implicitHeight: size
  opacity: enabled ? 1 : 0.35
  Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 200 } }

  scale: area.pressed ? 0.86 : area.containsMouse ? 1.06 : 1
  Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 5; damping: 0.3; epsilon: 0.002 } }

  Rectangle {
    anchors.fill: parent
    radius: Theme.radius > 0 ? width / 2 : 0
    color: c.filled ? c.tint : Qt.alpha(Theme.fg, area.containsMouse ? 0.1 : 0)
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 260 } }
  }

  Text {
    id: icon
    anchors.centerIn: parent
    text: c.glyph
    color: c.filled ? c.ink : c.on ? c.tint : Theme.fg
    font.family: Theme.fontMono
    font.pixelSize: c.size * (c.filled ? 0.44 : 0.5)
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 260 } }
  }
  onGlyphChanged: if (Theme.motion) pop.restart()
  SequentialAnimation {
    id: pop
    NumberAnimation { target: icon; property: "scale"; to: 0.6; duration: 90; easing.type: Easing.InQuad }
    NumberAnimation { target: icon; property: "scale"; to: 1; duration: 340; easing.type: Easing.OutBack; easing.overshoot: 3 }
  }

  Rectangle {
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.bottom
    anchors.topMargin: -2
    width: c.on ? 4 : 0
    height: width
    radius: width / 2
    color: c.tint
    Behavior on width { enabled: Theme.motion; NumberAnimation { duration: 220; easing.type: Easing.OutBack } }
  }

  MouseArea {
    id: area
    anchors.fill: parent
    hoverEnabled: true
    cursorShape: Qt.PointingHandCursor
    onClicked: c.clicked()
  }
}
