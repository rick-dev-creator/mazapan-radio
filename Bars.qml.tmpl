// Generated by mazapan (plugin {{ plugin }}): the sound as bars.
//
// With levels (cava, 0…1 each), they follow the sound, mirrored from the
// middle. Without, `breathing` ones rise and fall on their own while it
// plays (the bar's "playing" mark); stopped, they settle low.

import QtQuick
import qs

Item {
  id: bars

  property var levels: []
  property int count: 32
  property bool playing: true
  property bool breathing: false
  property color tint: Theme.fg
  property real gap: 2
  property real rest: 0.08

  readonly property real step: (width + gap) / count

  Repeater {
    model: bars.count

    Rectangle {
      id: bar
      required property int index
      // Breathing: each its own pace, so they never move together.
      property real wave: bars.rest
      readonly property real level: bars.breathing ? wave
        : bars.levels.length > 0 ? bars.levels[Math.floor(index * bars.levels.length / bars.count)] ?? 0
        : bars.rest
      readonly property real h: Math.max(2, bars.height * Math.max(bars.rest, bars.playing ? level : bars.rest))

      x: index * bars.step
      y: (bars.height - height) / 2
      width: Math.max(1, bars.step - bars.gap)
      height: h
      radius: Theme.radius > 0 ? width / 2 : 0
      color: bars.tint
      opacity: bars.playing ? 0.95 : 0.45
      Behavior on height { enabled: Theme.motion; NumberAnimation { duration: bars.breathing ? 260 : 70; easing.type: Easing.OutQuad } }
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 300 } }
      Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 600 } }

      SequentialAnimation on wave {
        running: bars.breathing && bars.playing && Theme.motion
        loops: Animation.Infinite
        NumberAnimation { to: 0.95; duration: 300 + bar.index * 97 % 230; easing.type: Easing.InOutSine }
        NumberAnimation { to: 0.3 + (bar.index * 37 % 30) / 100; duration: 260 + bar.index * 61 % 190; easing.type: Easing.InOutSine }
        NumberAnimation { to: 0.75; duration: 240 + bar.index * 43 % 170; easing.type: Easing.InOutSine }
        NumberAnimation { to: 0.2; duration: 320 + bar.index * 71 % 150; easing.type: Easing.InOutSine }
      }
    }
  }
}
