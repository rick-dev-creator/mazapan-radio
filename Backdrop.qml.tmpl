// Generated by mazapan (plugin {{ plugin }}): behind what's playing, its
// cover, blown up and blurred, washed in its color; the theme's surface
// where there's none. Crossfades with the song.

import QtQuick
import QtQuick.Effects
import qs

Item {
  id: back

  property string source: ""
  property color wash: Theme.surface
  property color base: Theme.surfaceRaised
  property real radius: Theme.radius
  // How much of the cover shows through.
  property real strength: 0.55

  layer.enabled: true
  layer.effect: MultiEffect {
    maskEnabled: back.radius > 0
    maskSource: shape
    maskThresholdMin: 0.5
    maskSpreadAtMin: 1
  }

  Rectangle {
    anchors.fill: parent
    color: back.base
  }

  Rectangle {
    anchors.fill: parent
    color: back.wash
    opacity: 0.85
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 700; easing.type: Easing.OutCubic } }
  }

  // The cover, far bigger than the card and blurred into light.
  Item {
    anchors.fill: parent
    opacity: back.strength
    layer.enabled: true
    layer.effect: MultiEffect {
      blurEnabled: true
      blur: 1
      blurMax: 64
      saturation: 0.25
    }

    Repeater {
      model: 2
      Image {
        required property int index
        readonly property bool front: index === (flip.front ? 0 : 1)
        anchors.centerIn: parent
        width: Math.max(parent.width, parent.height) * 1.5
        height: width
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        sourceSize: Qt.size(96, 96)
        source: index === 0 ? flip.a : flip.b
        opacity: front && status === Image.Ready ? 1 : 0
        Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 700; easing.type: Easing.InOutQuad } }
        // A slow drift, so it feels alive.
        rotation: 0
        RotationAnimation on rotation {
          running: Theme.motion && back.visible
          from: 0
          to: 360
          duration: 120000
          loops: Animation.Infinite
        }
      }
    }
  }

  QtObject {
    id: flip
    property bool front: true
    property string a: ""
    property string b: ""
  }
  onSourceChanged: {
    if (flip.front) flip.b = source
    else flip.a = source
    flip.front = !flip.front
  }
  Component.onCompleted: flip.a = source

  // Readable over any cover: the theme's surface comes back toward the bottom.
  Rectangle {
    anchors.fill: parent
    gradient: Gradient {
      GradientStop { position: 0; color: Qt.alpha(back.base, 0.15) }
      GradientStop { position: 1; color: Qt.alpha(back.base, 0.6) }
    }
  }

  Rectangle {
    id: shape
    anchors.fill: parent
    radius: back.radius
    visible: false
    layer.enabled: true
  }
}
