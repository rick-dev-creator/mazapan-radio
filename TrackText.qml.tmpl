// Generated by mazapan (plugin {{ plugin }}): a song's title or artist that
// changes with a small lift: the old one rises and fades, the new one comes
// up from below.

import QtQuick
import qs

Item {
  id: tt

  property string text: ""
  property alias color: label.color
  property alias pixelSize: label.pixelSize
  property alias bold: label.bold
  property alias family: label.family
  property alias running: label.running
  // A little later than the title, so they don't move as one.
  property int delay: 0

  property string held: ""
  implicitHeight: label.implicitHeight
  implicitWidth: label.implicitWidth
  clip: false

  Marquee {
    id: label
    width: tt.width
    text: tt.held
    transform: Translate { id: lift }
  }

  Component.onCompleted: held = text
  onTextChanged: {
    if (!Theme.motion || held === "") { held = text; return }
    swap.restart()
  }

  SequentialAnimation {
    id: swap
    PauseAnimation { duration: tt.delay }
    ParallelAnimation {
      NumberAnimation { target: label; property: "opacity"; to: 0; duration: 140; easing.type: Easing.InQuad }
      NumberAnimation { target: lift; property: "y"; to: -6; duration: 140; easing.type: Easing.InQuad }
    }
    ScriptAction { script: { tt.held = tt.text; lift.y = 8 } }
    ParallelAnimation {
      NumberAnimation { target: label; property: "opacity"; to: 1; duration: 320; easing.type: Easing.OutCubic }
      NumberAnimation { target: lift; property: "y"; to: 0; duration: 420; easing.type: Easing.OutBack; easing.overshoot: 2.2 }
    }
  }
}
