// Generated by mazapan (plugin {{ plugin }}): the radio, for the shell.
//
// The player is its own service (mazapan-radio, ~/.local/share/mazapan/bin/
// radio): it plays on with the panel closed, says what's on in
// $XDG_RUNTIME_DIR/mazapan-radio/now.json and keeps the library (favorites,
// recent stations, songs heard) in ~/.local/state/mazapan/radio. This reads
// both, sends it what's pressed, and browses Radio Browser's directory.

pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

Singleton {
  id: root

  // --- the settings, read live ------------------------------------------------

  readonly property var settings: Object.assign({ bar: true, visualizer: true, song_art: true, country: "" }, stored)
  property var stored: ({})
  FileView {
    path: Quickshell.shellPath("components/radio/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.stored = JSON.parse(text()) } catch (e) {} }
  }

  // --- the player, as it says ----------------------------------------------------

  readonly property string home: Quickshell.env("HOME")
  readonly property string bin: home + "/.local/share/mazapan/bin/radio"
  property var now: ({ status: "stopped" })
  property var library: ({ favorites: [], recent: [], heard: [], volume: 0.7, alarm: "" })

  FileView {
    id: nowFile
    path: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp") + "/mazapan-radio/now.json"
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.now = JSON.parse(text()) } catch (e) {} }
  }
  FileView {
    id: libraryFile
    path: root.home + "/.local/state/mazapan/radio/library.json"
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.library = JSON.parse(text()) } catch (e) {} }
  }
  // Until the player has written them once, there's nothing to watch: looked
  // at again now and then.
  Timer {
    interval: 2000
    repeat: true
    running: true
    onTriggered: { nowFile.reload(); libraryFile.reload() }
  }

  readonly property string status: now.status || "stopped"
  readonly property bool playing: status === "playing"
  readonly property bool connecting: status === "connecting"
  readonly property bool active: status === "playing" || status === "paused" || status === "connecting"
  readonly property var station: now.station || null
  readonly property var song: now.song || null
  readonly property string error: status === "error" ? (now.error || "") : ""
  readonly property real volume: now.volume ?? library.volume ?? 0.7
  readonly property int sleepAt: now.sleepAt || 0
  readonly property string alarm: library.alarm || ""
  readonly property var favorites: library.favorites || []
  readonly property var recent: library.recent || []
  readonly property var heard: library.heard || []
  readonly property string art: song && song.art ? song.art : ""

  function send(obj) { Quickshell.execDetached(["python3", bin, "send", JSON.stringify(obj)]) }
  function play(st, queue) { send({ cmd: "play", station: st, queue: queue || [st] }) }
  function toggle() { send({ cmd: "toggle" }) }
  function stop() { send({ cmd: "stop" }) }
  function next() { send({ cmd: "next" }) }
  function previous() { send({ cmd: "previous" }) }
  function setVolume(v) { send({ cmd: "volume", value: Math.max(0, Math.min(1, v)) }) }
  function favorite(st) { send({ cmd: "favorite", station: st }) }
  function sleepFor(minutes) { send({ cmd: "sleep", minutes: minutes }) }
  function setAlarm(at) { send({ cmd: "alarm", at: at }) }
  function forgetHeard() { send({ cmd: "forget-heard" }) }
  function isFavorite(st) { return !!st && favorites.some(f => f.stationuuid === st.stationuuid) }
  function isCurrent(st) { return !!st && !!station && station.stationuuid === st.stationuuid }

  IpcHandler {
    target: "radio"
    function toggle(): void { root.toggle() }
    function stop(): void { root.stop() }
    function next(): void { root.next() }
    function previous(): void { root.previous() }
  }

  // --- the directory -------------------------------------------------------------------

  readonly property var mirrors: ["https://all.api.radio-browser.info", "https://de1.api.radio-browser.info", "https://de2.api.radio-browser.info"]
  property var results: []
  property bool loading: false
  property string problem: ""
  property int asked: 0
  property var countries: []

  function fetch(path, params, done, failed) {
    const q = Object.keys(params || {}).map(k => k + "=" + encodeURIComponent(params[k])).join("&")
    const ask = i => {
      if (i >= mirrors.length) { failed(); return }
      const xhr = new XMLHttpRequest()
      xhr.timeout = 10000
      xhr.onreadystatechange = () => {
        if (xhr.readyState !== XMLHttpRequest.DONE) return
        if (xhr.status === 200) {
          try { done(JSON.parse(xhr.responseText)); return } catch (e) {}
        }
        ask(i + 1)
      }
      xhr.open("GET", mirrors[i] + path + (q ? "?" + q : ""))
      xhr.send()
    }
    ask(0)
  }

  function keep(s) {
    return { stationuuid: s.stationuuid, name: (s.name || "").trim(), url: s.url_resolved || s.url || "",
             favicon: s.favicon || "", country: s.country || "", countrycode: s.countrycode || "",
             tags: s.tags || "", codec: s.codec || "", bitrate: s.bitrate || 0, homepage: s.homepage || "" }
  }

  // kind: "tag", "search", "country", "top", "trending". Broken ones never;
  // the same stream listed twice, once.
  function browse(kind, value) {
    const id = ++asked
    loading = true
    problem = ""
    const base = { hidebroken: "true", limit: 60 }
    let path = "/json/stations/search", params
    if (kind === "tag") params = Object.assign(base, { tag: value, order: "votes", reverse: "true" })
    else if (kind === "search") params = Object.assign(base, { name: value, order: "votes", reverse: "true" })
    else if (kind === "country") params = Object.assign(base, { countrycode: value, order: "votes", reverse: "true" })
    else if (kind === "trending") params = Object.assign(base, { order: "clicktrend", reverse: "true" })
    else params = Object.assign(base, { order: "votes", reverse: "true" })
    fetch(path, params, list => {
      if (id !== asked) return
      const seen = {}
      results = list.map(keep).filter(s => {
        const k = s.url.replace(/\/+$/, "")
        if (!s.url || !s.name || seen[k]) return false
        seen[k] = true
        return true
      })
      loading = false
    }, () => {
      if (id !== asked) return
      loading = false
      problem = "offline"
    })
  }

  function loadCountries() {
    if (countries.length) return
    fetch("/json/countries", { order: "stationcount", reverse: "true", hidebroken: "true" }, list => {
      countries = list.filter(c => c.iso_3166_1 && c.stationcount > 3)
        .map(c => ({ code: c.iso_3166_1.toUpperCase(), name: c.name.replace(/^The /, ""), count: c.stationcount }))
    }, () => {})
  }

  Connections {
    target: Online
    function onBack() { if (root.problem) root.problem = "" }
  }

  // --- how things look ---------------------------------------------------------------------

  // A country's flag, from its two letters.
  function flag(cc) {
    if (!cc || cc.length !== 2) return ""
    const a = 0x1F1E6 - 65
    return String.fromCodePoint(a + cc.toUpperCase().charCodeAt(0), a + cc.toUpperCase().charCodeAt(1))
  }

  // The user's country, for "Near you": the setting, else the system's locale.
  readonly property string home_country: (settings.country || Qt.locale().name.split("_")[1] || "US").toUpperCase()

  // A hue of the station's own, for its tile when it has no logo.
  function hue(text) {
    let h = 0
    for (let i = 0; i < (text || "").length; i++) h = (h * 31 + text.charCodeAt(i)) % 360
    return h / 360
  }

  function initials(name) {
    const words = (name || "").replace(/[^A-Za-z0-9\u00C0-\uFFFF ]/g, " ").split(/\s+/).filter(w => w)
    return (words.length > 1 ? words[0][0] + words[1][0] : (words[0] || "?").slice(0, 2)).toUpperCase()
  }

  function tags(st, n) {
    return (st.tags || "").split(",").map(t => t.trim()).filter(t => t && t.length < 18).slice(0, n)
  }

  function ago(seconds) {
    const d = Math.max(0, Date.now() / 1000 - seconds)
    if (d < 60) return {{ tq "ago.now" }}
    if (d < 3600) return {{ tq "ago.min" }}.arg(Math.floor(d / 60))
    if (d < 86400) return {{ tq "ago.hour" }}.arg(Math.floor(d / 3600))
    return {{ tq "ago.day" }}.arg(Math.floor(d / 86400))
  }

  // --- the sound, as bars (cava), while the panel shows it ---------------------------------

  property bool panelOpen: false
  property bool hasCava: false
  property var levels: []
  readonly property bool listening: settings.visualizer && hasCava && playing && panelOpen

  Process {
    running: true
    command: ["sh", "-c", "command -v cava"]
    onExited: code => root.hasCava = code === 0
  }
  Process {
    running: root.listening
    command: ["cava", "-p", Quickshell.shellPath("components/radio/cava.conf")]
    stdout: SplitParser {
      onRead: line => {
        const v = line.split(";")
        v.pop()
        root.levels = v.map(x => Math.min(1, Number(x) / 100))
      }
    }
    onRunningChanged: if (!running) root.levels = []
  }
}
