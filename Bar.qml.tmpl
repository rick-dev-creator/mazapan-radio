// Generated by mazapan (plugin {{ plugin }}): the radio in the bar, while
// one is on.
//
// Its mark in the accent, breathing while it plays, and the station's name.
// A click opens the panel; a right click plays or pauses; a middle click
// goes to the next station; the wheel changes its volume. (The song itself
// shows wherever the system shows what's playing.)

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/radio"

BarItem {
  id: root

  shown: Radio.settings.bar && (Radio.active || Radio.status === "error")
  acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) Radio.toggle()
    else if (mouse.button === Qt.MiddleButton) Radio.next()
    else Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "radio"])
  }
  onWheel: event => Radio.setVolume(Radio.volume + (event.angleDelta.y > 0 ? 0.05 : -0.05))

  Text {
    anchors.verticalCenter: parent.verticalCenter
    text: "󰐹"
    color: Radio.status === "error" ? Theme.danger : Radio.playing ? Theme.accent : Theme.fgMuted
    font.family: Theme.fontMono
    font.pixelSize: Theme.fontSize * 1.35
    SequentialAnimation on opacity {
      running: (Radio.playing || Radio.connecting) && Theme.motion
      loops: Animation.Infinite
      NumberAnimation { to: 0.55; duration: 1100; easing.type: Easing.InOutSine }
      NumberAnimation { to: 1; duration: 1100; easing.type: Easing.InOutSine }
    }
  }

  Text {
    anchors.verticalCenter: parent.verticalCenter
    width: Math.min(implicitWidth, 150)
    elide: Text.ElideRight
    text: Radio.station ? Radio.station.name : ""
    color: Radio.playing ? Theme.fg : Theme.fgMuted
    font.family: Theme.fontMono
    font.pixelSize: Theme.fontSize * 1.2
    textFormat: Text.PlainText
  }
}
