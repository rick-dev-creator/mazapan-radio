// Generated by mazapan (plugin {{ plugin }}): how far along the song is.
//
// Grows under the pointer; dragged (or clicked), it shows where it would
// go and goes there when let go. Moves smoothly between the times it's told.

import QtQuick
import qs

Item {
  id: seek

  property real value: 0          // 0…1
  property bool interactive: true
  property color tint: Theme.fg
  property real thin: 4
  property real thick: 8
  signal moved(real fraction)

  readonly property bool active: interactive && (area.containsMouse || area.pressed)
  readonly property real shown: area.pressed ? drag : eased
  property real drag: 0
  property real eased: value
  Behavior on eased {
    enabled: Theme.motion && !area.pressed
    NumberAnimation { duration: 520; easing.type: Easing.Linear }
  }

  implicitHeight: thick + 8

  Rectangle {
    id: track
    anchors.verticalCenter: parent.verticalCenter
    width: parent.width
    height: seek.active ? seek.thick : seek.thin
    radius: Math.min(height / 2, Theme.radius > 0 ? height / 2 : 0)
    color: Qt.alpha(Theme.fg, 0.16)
    Behavior on height { enabled: Theme.motion; NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }

    Rectangle {
      width: Math.max(track.radius * 2, track.width * seek.shown)
      height: parent.height
      radius: parent.radius
      color: seek.active ? seek.tint : Qt.alpha(seek.tint, 0.9)
      Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 600 } }
    }
  }

  // The knob, only while it's in hand.
  Rectangle {
    x: track.width * seek.shown - width / 2
    anchors.verticalCenter: parent.verticalCenter
    width: seek.active ? seek.thick + 6 : 0
    height: width
    radius: Theme.radius > 0 ? width / 2 : 0
    color: Theme.fg
    visible: width > 0.5
    Behavior on width { enabled: Theme.motion; NumberAnimation { duration: 180; easing.type: Easing.OutBack } }
  }

  MouseArea {
    id: area
    anchors.fill: parent
    anchors.topMargin: -6
    anchors.bottomMargin: -6
    enabled: seek.interactive
    hoverEnabled: true
    preventStealing: true
    cursorShape: seek.interactive ? Qt.PointingHandCursor : Qt.ArrowCursor
    function at(x) { return Math.max(0, Math.min(1, x / seek.width)) }
    onPressed: mouse => seek.drag = at(mouse.x)
    onPositionChanged: mouse => { if (pressed) seek.drag = at(mouse.x) }
    onReleased: {
      seek.eased = seek.drag
      seek.moved(seek.drag)
    }
  }
}
