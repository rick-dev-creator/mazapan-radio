#!/usr/bin/env python3
# Generated by mazapan (plugin {{ plugin }}): the radio.
#
#   radio daemon          the player (mazapan-radio.service): mpv, MPRIS,
#                         what's playing, the song's cover, the library
#   radio send JSON       a command to it, started first if it isn't
#   radio tune WHAT       from the palette: a mood (jazz), "favorites",
#                         "recent", "random", or a station's name
#   radio wake            the alarm's: the last station, its volume rising
#
# Stations come from Radio Browser (radio-browser.info), the community's
# directory. Each one is checked before it plays: a stream that leads to
# this computer or its local network (directly or through a redirect) is
# refused. The song a station sends ("Artist - Title") is looked up on
# iTunes for its cover (the song's name only; off in the settings).
#
# Kept: ~/.local/state/mazapan/radio/library.json (favorites, recent
# stations, songs heard, volume, alarm); covers in ~/.cache/mazapan/radio.
# Live: $XDG_RUNTIME_DIR/mazapan-radio/now.json, read by the shell.

import hashlib
import ipaddress
import json
import os
import random
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "mazapan-radio")
CTL = os.path.join(RUN, "ctl.sock")
MPV = os.path.join(RUN, "mpv.sock")
NOW = os.path.join(RUN, "now.json")
STATE = os.path.join(HOME, ".local/state/mazapan/radio")
LIBRARY = os.path.join(STATE, "library.json")
ART = os.path.join(HOME, ".cache/mazapan/radio")
SETTINGS = os.path.join(HOME, ".config/quickshell/mazapan/components/radio/settings.json")
MIRRORS = ["https://all.api.radio-browser.info", "https://de1.api.radio-browser.info", "https://de2.api.radio-browser.info"]
UA = "Mazapan-Radio/0.1 (+https://github.com/rick-dev-creator/mazapan-radio)"
KEEP_RECENT, KEEP_HEARD = 30, 200


def settings():
    s = {"song_art": True}
    try:
        with open(SETTINGS) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    return s


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def http(url, timeout=10, limit=2 << 20):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read(limit)


# --- the directory -------------------------------------------------------------


def directory(path, params=None):
    """Radio Browser, trying its mirrors in turn."""
    q = "?" + urllib.parse.urlencode(params) if params else ""
    err = None
    for m in random.sample(MIRRORS, len(MIRRORS)):
        try:
            return json.loads(http(m + path + q))
        except (OSError, ValueError) as e:
            err = e
    raise OSError(f"Radio Browser didn't answer: {err}")


def station(s):
    """What's kept of a station: what it needs to play and to be shown."""
    return {k: s.get(k) or "" for k in ["stationuuid", "name", "favicon", "country", "countrycode", "tags", "codec", "homepage"]} | {
        "url": s.get("url_resolved") or s.get("url") or "", "bitrate": int(s.get("bitrate") or 0)}


def search(**params):
    params = {"hidebroken": "true", "order": "votes", "reverse": "true", "limit": 40, **params}
    return [station(s) for s in directory("/json/stations/search", params)]


# --- streams, checked ---------------------------------------------------------------


def outside(host):
    """Every address the host has is on the internet: not this computer, not the local network."""
    try:
        infos = socket.getaddrinfo(host, None)
    except OSError:
        return False
    for info in infos:
        ip = ipaddress.ip_address(info[4][0].split("%")[0])
        # NAT64 (64:ff9b::/96): the IPv4 address inside is the one that counts.
        if ip.version == 6 and ip in ipaddress.ip_network("64:ff9b::/96"):
            ip = ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF)
        if ip.version == 6 and ip.ipv4_mapped:
            ip = ip.ipv4_mapped
        if not ip.is_global or ip.is_multicast:
            return False
    return True


class Checked(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not safe(newurl):
            raise urllib.error.URLError("a redirect to the local network")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def safe(url):
    u = urllib.parse.urlparse(url)
    return u.scheme in ("http", "https") and bool(u.hostname) and outside(u.hostname)


def resolve(url, depth=0):
    """The stream to give mpv: redirects followed and checked, a playlist's first entry."""
    if not safe(url):
        raise OSError("refused: it leads to this computer or its local network")
    opener = urllib.request.build_opener(Checked)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Icy-MetaData": "0"})
    with opener.open(req, timeout=10) as r:
        final, kind = r.geturl(), (r.headers.get("Content-Type") or "").lower()
        playlist = any(k in kind for k in ("mpegurl", "scpls", "x-pls")) or final.lower().split("?")[0].endswith((".m3u", ".m3u8", ".pls"))
        if playlist and "application/vnd.apple.mpegurl" not in kind and depth < 2:
            text = r.read(64 << 10).decode("utf-8", "replace")
            for line in text.splitlines():
                line = line.strip()
                if line.lower().startswith("file") and "=" in line:
                    line = line.split("=", 1)[1].strip()
                if line.startswith(("http://", "https://")):
                    return resolve(line, depth + 1)
            raise OSError("an empty playlist")
    if not safe(final):
        raise OSError("refused: it leads to this computer or its local network")
    return final


# --- covers ---------------------------------------------------------------------------


NOISE = re.compile(r"\b[\w-]+\.(com|net|org|fm|radio|info|io|de|uk|fr|es|it|nl|ru|jp)\b|^(live|on air|now playing|advert\w*|commercial|news)$", re.I)


ADS = re.compile(r"\b(advert\w*|commercial break|ad ?break|spot publicitaire|publicidad|werbung)\b", re.I)


def split_song(text, station_name):
    """
    What a station says it plays, as {artist, title}: "Artist - Title" as
    most send it, "Title by Artist" as some do; a station's own tagline (its
    name, its web address) taken out. None when it's only the station.
    """
    text = (text or "").strip()
    name = (station_name or "").strip().lower()
    # An ad break isn't a song.
    if not text or ADS.search(text):
        return None
    def noise(part):
        p = part.strip().lower()
        # The station's name: a short one ("Y") only when it's all there is.
        mine = p == name or (len(name) >= 4 and name in p) or (len(p) >= 4 and p in name)
        return not p or NOISE.search(p) or mine
    parts = [p.strip() for p in re.split(r"\s+[-\u2013\u2014|~]\s+", text) if not noise(p)]
    if not parts:
        return None
    if len(parts) == 1:
        by = re.match(r"(.+?)\s+by\s+(.+)$", parts[0], re.I)
        if by:
            return {"artist": by[2].strip(), "title": by[1].strip()}
        return {"artist": "", "title": parts[0]}
    return {"artist": parts[0], "title": " - ".join(parts[1:])}


_covers = {}


def cover(song):
    """
    The song's cover from iTunes, kept on disk: (a file path or "", the song
    as iTunes knows it). Some stations send "Title - Artist": when the
    artist doesn't match but the title does, the two are swapped.
    """
    if not song or not song["artist"] or not settings().get("song_art", True):
        return "", song
    key = (song["artist"] + " - " + song["title"]).lower()
    if key in _covers:
        return _covers[key]
    path = os.path.join(ART, hashlib.sha1(key.encode()).hexdigest() + ".jpg")
    if not os.path.exists(path):
        try:
            q = urllib.parse.urlencode({"term": f'{song["artist"]} {song["title"]}', "entity": "song", "limit": 3})
            found = json.loads(http("https://itunes.apple.com/search?" + q, timeout=8)).get("results", [])
            match = lambda a, b: a and b and (a in b or b in a)
            hit = next((r for r in found if match(song["artist"].lower(), r.get("artistName", "").lower())), None)
            if not hit:
                hit = next((r for r in found if match(song["title"].lower(), r.get("artistName", "").lower())), None)
                if hit:
                    song = {"artist": song["title"], "title": song["artist"]}
            if not hit or not hit.get("artworkUrl100"):
                _covers[key] = ("", song)
                return _covers[key]
            os.makedirs(ART, exist_ok=True)
            data = http(hit["artworkUrl100"].replace("100x100bb", "600x600bb"), timeout=10, limit=4 << 20)
            with open(path + ".tmp", "wb") as f:
                f.write(data)
            os.replace(path + ".tmp", path)
        except (OSError, ValueError):
            return "", song
    _covers[key] = (path, song)
    return _covers[key]


# --- the player ----------------------------------------------------------------------------


class Radio:
    def __init__(self):
        self.lock = threading.RLock()
        self.lib = {"favorites": [], "recent": [], "heard": [], "volume": 0.7, "alarm": ""}
        try:
            with open(LIBRARY) as f:
                self.lib.update(json.load(f))
        except (OSError, ValueError):
            pass
        self.proc = None
        self.station = None
        self.queue = []
        self.status = "stopped"      # stopped, connecting, playing, paused, error
        self.error = ""
        self.song = None             # {"artist", "title", "art"}
        self.said = ""               # what the station last said is playing
        self.sleep_at = 0
        self.fade = None
        self.mpris = None
        self.generation = 0

    # what the shell and MPRIS see
    def snapshot(self):
        return {"status": self.status, "station": self.station, "song": self.song, "error": self.error,
                "volume": self.lib["volume"], "sleepAt": self.sleep_at, "alarm": self.lib.get("alarm", ""),
                "canNext": len(self.queue) > 1, "at": time.time()}

    def changed(self):
        write_json(NOW, self.snapshot())
        if self.mpris:
            self.mpris.changed()

    def save(self):
        write_json(LIBRARY, self.lib)

    # mpv
    def mpv(self, *cmd):
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.settimeout(2)
                s.connect(MPV)
                s.sendall((json.dumps({"command": list(cmd)}) + "\n").encode())
        except OSError:
            pass

    def kill(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None

    def play(self, st, queue=None):
        with self.lock:
            self.generation += 1
            gen = self.generation
            self.kill()
            self.station, self.song, self.error, self.status, self.said = st, None, "", "connecting", ""
            if queue is not None:
                self.queue = [q for q in queue if q.get("url")] or [st]
            self.lib["recent"] = [st] + [r for r in self.lib["recent"] if r.get("stationuuid") != st.get("stationuuid")][:KEEP_RECENT - 1]
            self.save()
            self.changed()
        threading.Thread(target=self._start, args=(st, gen), daemon=True).start()

    def _start(self, st, gen):
        try:
            url = resolve(st["url"])
        except (OSError, ValueError) as e:
            with self.lock:
                if gen == self.generation:
                    self.status, self.error = "error", str(getattr(e, "reason", e))
                    self.changed()
            return
        with self.lock:
            if gen != self.generation:
                return
            try:
                os.unlink(MPV)
            except OSError:
                pass
            self.proc = subprocess.Popen(
                ["mpv", "--no-config", "--load-scripts=no", "--no-video", "--idle=no", "--no-terminal",
                 f"--input-ipc-server={MPV}", f"--volume={round(self.lib['volume'] * 100)}",
                 "--cache=yes", "--demuxer-readahead-secs=8", "--network-timeout=15",
                 f"--user-agent={UA}", "--", url],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        threading.Thread(target=self._watch, args=(gen,), daemon=True).start()
        # Counted in the directory, as it asks of players.
        if st.get("stationuuid"):
            threading.Thread(target=lambda: directory("/json/url/" + st["stationuuid"]), daemon=True).start()

    def _watch(self, gen):
        """mpv's events: the stream started, the song changed, it ended."""
        for _ in range(50):
            if os.path.exists(MPV):
                break
            time.sleep(0.1)
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(MPV)
        except OSError:
            self._failed(gen, "the player didn't start")
            return
        with s:
            for i, prop in enumerate(["metadata", "pause", "core-idle"], 1):
                s.sendall((json.dumps({"command": ["observe_property", i, prop]}) + "\n").encode())
            buf = b""
            while True:
                try:
                    chunk = s.recv(65536)
                except OSError:
                    break
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    if gen != self.generation:
                        return
                    self._event(ev, gen)
        if gen == self.generation and self.status in ("connecting", "playing", "paused"):
            self._failed(gen, "the station stopped sending")

    def _event(self, ev, gen):
        name, data = ev.get("name"), ev.get("data")
        if ev.get("event") == "end-file" and ev.get("reason") == "error":
            self._failed(gen, "the station can't be played")
        elif self.status == "connecting" and (ev.get("event") == "playback-restart" or (name == "core-idle" and data is False)):
            with self.lock:
                self.status = "playing"
                self.changed()
        elif ev.get("event") == "property-change" and name == "pause" and self.status in ("playing", "paused"):
            with self.lock:
                self.status = "paused" if data else "playing"
                self.changed()
        elif ev.get("event") == "property-change" and name == "metadata" and isinstance(data, dict):
            text = data.get("icy-title") or data.get("StreamTitle") or data.get("title") or ""
            # The same words again (stations repeat them): the same song, even turned round.
            if text == self.said:
                return
            self.said = text
            song = split_song(text, (self.station or {}).get("name"))
            if song:
                with self.lock:
                    self.song = dict(song, art="")
                    self._heard(self.song)
                    self.changed()
                threading.Thread(target=self._cover, args=(dict(song), gen), daemon=True).start()

    def _cover(self, song, gen):
        art, known = cover(song)
        with self.lock:
            if gen != self.generation or not self.song or self.song["title"] != song["title"]:
                return
            # The song as iTunes knows it (artist and title the right way round).
            for h in self.lib["heard"][:3]:
                if h["title"] == song["title"] and h["artist"] == song["artist"]:
                    h.update(artist=known["artist"], title=known["title"], art="file://" + art if art else "")
            self.song.update(artist=known["artist"], title=known["title"], art="file://" + art if art else "")
            self.save()
            self.changed()

    def _heard(self, song):
        st = self.station or {}
        # The same song from the same station within a quarter of an hour
        # (tuning in again, a reconnect): heard once.
        if any(h.get("title") == song["title"] and h.get("artist") == song["artist"] and h.get("station") == st.get("name")
               and time.time() - h.get("at", 0) < 900 for h in self.lib["heard"][:20]):
            return
        self.lib["heard"] = [{"title": song["title"], "artist": song["artist"], "art": "",
                              "station": st.get("name", ""), "countrycode": st.get("countrycode", ""),
                              "at": int(time.time())}] + self.lib["heard"][:KEEP_HEARD - 1]
        self.save()

    def _failed(self, gen, why):
        with self.lock:
            if gen != self.generation:
                return
            self.kill()
            self.status, self.error = "error", why
            self.changed()

    # the buttons
    def toggle(self):
        if self.status in ("playing", "paused"):
            self.mpv("cycle", "pause")
        elif self.station:
            self.play(self.station)
        elif self.lib["recent"]:
            self.play(self.lib["recent"][0], self.lib["recent"])

    def pause(self):
        if self.status == "playing":
            self.mpv("set_property", "pause", True)

    def resume(self):
        if self.status == "paused":
            self.mpv("set_property", "pause", False)
        elif self.status in ("stopped", "error"):
            self.toggle()

    def stop(self):
        with self.lock:
            self.generation += 1
            self.kill()
            self.status, self.song, self.sleep_at = "stopped", None, 0
            self.changed()

    def step(self, d):
        if not self.queue:
            return
        uuids = [q.get("stationuuid") for q in self.queue]
        i = uuids.index(self.station.get("stationuuid")) if self.station and self.station.get("stationuuid") in uuids else -d
        self.play(self.queue[(i + d) % len(self.queue)])

    def volume(self, v):
        v = max(0.0, min(1.0, float(v)))
        self.lib["volume"] = v
        self.mpv("set_property", "volume", round(v * 100))
        self.save()
        self.changed()

    def favorite(self, st):
        favs = self.lib["favorites"]
        if any(f.get("stationuuid") == st.get("stationuuid") for f in favs):
            self.lib["favorites"] = [f for f in favs if f.get("stationuuid") != st.get("stationuuid")]
        else:
            self.lib["favorites"] = [st] + favs
        self.save()
        self.changed()

    def sleep(self, minutes):
        minutes = int(minutes)
        self.sleep_at = int(time.time() + minutes * 60) if minutes > 0 else 0
        self.changed()

    def alarm(self, at):
        """An alarm at HH:MM every day, as a timer of systemd's (it wakes the radio up even when it's off)."""
        subprocess.run(["systemctl", "--user", "stop", "mazapan-radio-alarm.timer"], capture_output=True)
        if at:
            hh, mm = (int(x) for x in at.split(":"))
            subprocess.run(["systemd-run", "--user", "--quiet", "--unit=mazapan-radio-alarm",
                            f"--on-calendar=*-*-* {hh:02d}:{mm:02d}:00", "--timer-property=AccuracySec=1s",
                            "/usr/bin/python3", os.path.abspath(__file__), "wake"], capture_output=True)
            at = f"{hh:02d}:{mm:02d}"
        self.lib["alarm"] = at or ""
        self.save()
        self.changed()

    def wake(self):
        st = (self.lib["recent"] or self.lib["favorites"] or [None])[0]
        if not st:
            return
        target, self.lib["volume"] = self.lib["volume"], 0.05
        self.play(st, self.lib["favorites"] or self.lib["recent"])
        self.fade = (time.time(), 60, 0.05, target)

    def tick(self):
        """Once a second: the sleep timer (its last 30 s fading out), the alarm's rise."""
        now = time.time()
        if self.sleep_at and self.status in ("playing", "paused"):
            left = self.sleep_at - now
            if left <= 0:
                vol = self.lib["volume"]
                self.stop()
                self.lib["volume"] = vol
            elif left < 30:
                self.mpv("set_property", "volume", round(self.lib["volume"] * 100 * left / 30))
        if self.fade:
            start, span, a, b = self.fade
            k = min(1.0, (now - start) / span)
            self.lib["volume"] = a + (b - a) * k
            self.mpv("set_property", "volume", round(self.lib["volume"] * 100))
            if k >= 1:
                self.fade = None
                self.save()

    def tune(self, what):
        what = (what or "").strip()
        if what in ("favorites", "recent"):
            # Yours, or nothing (never a search for the word).
            lst = self.lib[what]
        elif what == "random":
            lst = [station(s) for s in directory("/json/stations/search", {"hidebroken": "true", "order": "random", "limit": 20, "bitrateMin": 96})]
        else:
            lst = search(tag=what, limit=30) or search(name=what, limit=30)
        if lst:
            self.play(lst[0] if what != "random" else random.choice(lst), lst)

    def command(self, c):
        cmd = c.get("cmd")
        if cmd == "play":
            self.play(c["station"], c.get("queue"))
        elif cmd in ("toggle", "pause", "resume", "stop"):
            getattr(self, cmd)()
        elif cmd == "next":
            self.step(1)
        elif cmd == "previous":
            self.step(-1)
        elif cmd == "volume":
            self.volume(c["value"])
        elif cmd == "favorite":
            self.favorite(c["station"])
        elif cmd == "sleep":
            self.sleep(c.get("minutes", 0))
        elif cmd == "alarm":
            self.alarm(c.get("at", ""))
        elif cmd == "forget-heard":
            self.lib["heard"] = []
            self.save()
        elif cmd == "tune":
            threading.Thread(target=self.tune, args=(c.get("what"),), daemon=True).start()
        elif cmd == "wake":
            self.wake()
        return self.snapshot()


# --- MPRIS: Playback, Now Playing and the media keys see it ----------------------------------


def mpris(radio):
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    DBusGMainLoop(set_as_default=True)
    ROOT, PLAYER, PROPS = "org.mpris.MediaPlayer2", "org.mpris.MediaPlayer2.Player", "org.freedesktop.DBus.Properties"

    class Mpris(dbus.service.Object):
        def __init__(self):
            self.name = dbus.service.BusName("org.mpris.MediaPlayer2.mazapan_radio", dbus.SessionBus())
            super().__init__(self.name, "/org/mpris/MediaPlayer2")
            self.track = 0
            self.last = None

        def metadata(self):
            st, song = radio.station or {}, radio.song or {}
            meta = {"mpris:trackid": dbus.ObjectPath(f"/org/mazapan/radio/track/{self.track}"),
                    "xesam:title": song.get("title") or st.get("name", ""),
                    # No song said: the station alone, not its name twice.
                    "xesam:artist": dbus.Array([song.get("artist", "")] if song.get("artist") else [], signature="s"),
                    "xesam:album": st.get("name", "") if song else (st.get("country", "") or "")}
            art = song.get("art") or (st.get("favicon") if st.get("favicon", "").startswith("https://") else "")
            if art:
                meta["mpris:artUrl"] = art
            return dbus.Dictionary(meta, signature="sv")

        def props(self, iface):
            if iface == ROOT:
                return {"CanQuit": True, "CanRaise": True, "HasTrackList": False, "Identity": "Radio",
                        "SupportedUriSchemes": dbus.Array([], signature="s"), "SupportedMimeTypes": dbus.Array([], signature="s")}
            status = {"playing": "Playing", "paused": "Paused", "connecting": "Playing"}.get(radio.status, "Stopped")
            return {"PlaybackStatus": status, "Rate": 1.0, "MinimumRate": 1.0, "MaximumRate": 1.0,
                    "Metadata": self.metadata(), "Volume": float(radio.lib["volume"]), "Position": dbus.Int64(0),
                    "CanGoNext": len(radio.queue) > 1, "CanGoPrevious": len(radio.queue) > 1,
                    "CanPlay": bool(radio.station or radio.lib["recent"]), "CanPause": True, "CanSeek": False, "CanControl": True}

        def changed(self):
            from gi.repository import GLib
            def emit():
                key = json.dumps([radio.status, radio.station and radio.station.get("stationuuid"), radio.song], sort_keys=True)
                if key != self.last:
                    self.track += 1
                    self.last = key
                self.PropertiesChanged(PLAYER, self.props(PLAYER), [])
                return False
            GLib.idle_add(emit)

        @dbus.service.method(PROPS, in_signature="ss", out_signature="v")
        def Get(self, iface, prop):
            return self.props(iface)[prop]

        @dbus.service.method(PROPS, in_signature="s", out_signature="a{sv}")
        def GetAll(self, iface):
            return self.props(iface)

        @dbus.service.method(PROPS, in_signature="ssv")
        def Set(self, iface, prop, value):
            if prop == "Volume":
                radio.volume(value)

        @dbus.service.signal(PROPS, signature="sa{sv}as")
        def PropertiesChanged(self, iface, changed, invalidated):
            pass

        @dbus.service.method(ROOT)
        def Raise(self):
            subprocess.Popen(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "radio"])

        @dbus.service.method(ROOT)
        def Quit(self):
            radio.stop()

        @dbus.service.method(PLAYER)
        def Play(self): radio.resume()

        @dbus.service.method(PLAYER)
        def Pause(self): radio.pause()

        @dbus.service.method(PLAYER)
        def PlayPause(self): radio.toggle()

        @dbus.service.method(PLAYER)
        def Stop(self): radio.stop()

        @dbus.service.method(PLAYER)
        def Next(self): radio.step(1)

        @dbus.service.method(PLAYER)
        def Previous(self): radio.step(-1)

        @dbus.service.method(PLAYER, in_signature="x")
        def Seek(self, offset): pass

        @dbus.service.method(PLAYER, in_signature="ox")
        def SetPosition(self, track, position): pass

        @dbus.service.method(PLAYER, in_signature="s")
        def OpenUri(self, uri): pass

    return Mpris()


# --- the daemon and its socket --------------------------------------------------------------------


def daemon():
    from gi.repository import GLib
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    radio = Radio()
    try:
        radio.mpris = mpris(radio)
    except Exception as e:  # no session bus: it plays, without MPRIS
        print(f"radio: no MPRIS: {e}", file=sys.stderr)
    radio.changed()

    try:
        os.unlink(CTL)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(CTL)
    os.chmod(CTL, 0o600)
    srv.listen(8)

    def serve():
        while True:
            conn, _ = srv.accept()
            with conn:
                try:
                    conn.settimeout(5)
                    data = b""
                    while not data.endswith(b"\n"):
                        chunk = conn.recv(1 << 20)
                        if not chunk:
                            break
                        data += chunk
                    reply = radio.command(json.loads(data))
                except Exception as e:
                    reply = {"error": str(e)}
                try:
                    conn.sendall((json.dumps(reply) + "\n").encode())
                except OSError:
                    pass

    threading.Thread(target=serve, daemon=True).start()
    GLib.timeout_add(1000, lambda: (radio.tick(), True)[1])
    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        add_signal = lambda sig, fn: GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, fn)
    except ImportError:
        add_signal = lambda sig, fn: GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, fn)
    for sig in (15, 2):
        add_signal(sig, lambda: (radio.kill(), loop.quit(), False)[2])
    loop.run()


def send(c):
    """A command to the daemon, starting it first when it isn't there."""
    for attempt in range(40):
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.settimeout(5)
                s.connect(CTL)
                s.sendall((json.dumps(c) + "\n").encode())
                return s.recv(1 << 20).decode()
        except OSError:
            if attempt == 0:
                subprocess.run(["systemctl", "--user", "start", "mazapan-radio.service"], capture_output=True)
            time.sleep(0.15)
    print("radio: the player didn't start (systemctl --user status mazapan-radio)", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    what = sys.argv[1] if len(sys.argv) > 1 else ""
    if what == "daemon":
        daemon()
    elif what == "send":
        print(send(json.loads(sys.argv[2])))
    elif what == "tune":
        send({"cmd": "tune", "what": " ".join(sys.argv[2:])})
    elif what == "wake":
        send({"cmd": "wake"})
    else:
        print(__doc__ or "radio daemon | send JSON | tune WHAT | wake")
        sys.exit(2)
