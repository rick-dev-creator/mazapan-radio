// Generated by mazapan (plugin {{ plugin }}): a station's logo, in the
// theme's shape. Its own picture when it has one that loads (and isn't a
// speck); else its initials on a gradient of a hue of its own, so every
// station is told apart at a glance. A song's cover fades in over it.

import QtQuick
import QtQuick.Effects
import qs

Item {
  id: logo

  property string source: ""        // the station's picture
  property string cover: ""         // the song's, over it when there is one
  property string name: ""
  property real radius: Theme.radius

  readonly property real hue: Radio.hue(name)
  readonly property bool hasPicture: pic.status === Image.Ready && pic.sourceSize.width >= 24

  layer.enabled: radius > 0
  layer.effect: MultiEffect {
    maskEnabled: true
    maskSource: shape
    maskThresholdMin: 0.5
    maskSpreadAtMin: 1
  }

  Rectangle {
    anchors.fill: parent
    gradient: Gradient {
      orientation: Gradient.Vertical
      GradientStop { position: 0; color: Qt.hsla(logo.hue, 0.55, Theme.mode === "light" ? 0.62 : 0.5, 1) }
      GradientStop { position: 1; color: Qt.hsla((logo.hue + 0.08) % 1, 0.6, Theme.mode === "light" ? 0.45 : 0.28, 1) }
    }
    Text {
      anchors.centerIn: parent
      visible: !logo.hasPicture
      text: Radio.initials(logo.name)
      color: "#ffffff"
      opacity: 0.92
      font.family: Theme.fontMono
      font.bold: true
      font.pixelSize: Math.max(9, logo.width * 0.34)
    }
  }

  // A logo on a white or clear ground sits on a plate, not on the gradient.
  Rectangle {
    anchors.fill: parent
    visible: logo.hasPicture
    color: Theme.mode === "light" ? "#ffffff" : Qt.rgba(1, 1, 1, 0.92)
  }
  Image {
    id: pic
    anchors.fill: parent
    anchors.margins: logo.width * 0.08
    source: logo.source.startsWith("https://") || logo.source.startsWith("http://") ? logo.source : ""
    fillMode: Image.PreserveAspectFit
    asynchronous: true
    cache: true
    sourceSize: Qt.size(logo.width * 2, logo.height * 2)
    visible: logo.hasPicture
    smooth: true
  }

  Image {
    anchors.fill: parent
    source: logo.cover
    fillMode: Image.PreserveAspectCrop
    asynchronous: true
    sourceSize: Qt.size(logo.width * 2, logo.height * 2)
    opacity: status === Image.Ready ? 1 : 0
    Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 450; easing.type: Easing.OutCubic } }
  }

  Rectangle {
    id: shape
    anchors.fill: parent
    radius: logo.radius
    visible: false
    layer.enabled: true
  }
}
