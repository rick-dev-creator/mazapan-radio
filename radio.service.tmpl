# Generated by mazapan (plugin {{ plugin }}): the radio's player. Started by
# the panel or the palette when it's first needed; plays on with the panel
# closed; MPRIS for the media keys and the bar's player.
[Unit]
Description=Mazapan: the radio's player
# Never "failed" for starting often: the panel starts it again.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/mazapan/bin/radio daemon
Restart=on-failure
RestartSec=2
