// Generated by mazapan (plugin {{ plugin }}): a station, as a card.
//
// Its logo, its name, its country's flag, codec and bitrate, its first
// genres. Under the pointer it lifts and takes the accent's edge; the one
// playing keeps it, with bars that move. A star keeps it in the favorites.

import QtQuick
import QtQuick.Layouts
import qs

Item {
  id: card

  property var station: ({})
  property bool selected: false
  property int order: 0               // its place, for a staggered entrance
  signal play()

  readonly property bool current: Radio.isCurrent(station)
  readonly property bool favorite: Radio.isFavorite(station)
  readonly property bool lifted: hover.hovered || selected

  // In, one after another.
  opacity: 0
  transform: Translate { id: rise; y: Theme.motion ? 10 : 0 }
  Component.onCompleted: entrance.start()
  ParallelAnimation {
    id: entrance
    SequentialAnimation {
      PauseAnimation { duration: Theme.motion ? Math.min(card.order, 18) * 22 : 0 }
      NumberAnimation { target: card; property: "opacity"; to: 1; duration: Theme.motion ? 260 : 0; easing.type: Easing.OutCubic }
    }
    SequentialAnimation {
      PauseAnimation { duration: Theme.motion ? Math.min(card.order, 18) * 22 : 0 }
      NumberAnimation { target: rise; property: "y"; to: 0; duration: Theme.motion ? 360 : 0; easing.type: Easing.OutCubic }
    }
  }

  Rectangle {
    id: face
    anchors.fill: parent
    anchors.margins: 4
    radius: Theme.radius
    color: card.lifted ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: card.current ? Theme.accent : card.lifted ? Qt.alpha(Theme.accent, 0.55) : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 160 } }
    Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 160 } }
    transform: Translate { y: card.lifted ? -2 : 0; Behavior on y { enabled: Theme.motion; NumberAnimation { duration: 160; easing.type: Easing.OutCubic } } }

    RowLayout {
      anchors.fill: parent
      anchors.margins: 10
      spacing: 10

      Item {
        Layout.preferredWidth: 52
        Layout.preferredHeight: 52
        Logo {
          anchors.fill: parent
          source: card.station.favicon || ""
          name: card.station.name || ""
          radius: Math.min(Theme.radius, 8)
        }
        // Playing: its bars over the logo.
        Rectangle {
          anchors.fill: parent
          radius: Math.min(Theme.radius, 8)
          color: Qt.rgba(0, 0, 0, 0.45)
          visible: card.current && Radio.active
          Bars {
            anchors.centerIn: parent
            width: 22
            height: 18
            count: 4
            gap: 3
            rest: 0.25
            breathing: true
            playing: Radio.playing
            tint: "#ffffff"
          }
        }
      }

      ColumnLayout {
        Layout.fillWidth: true
        spacing: 3
        Text {
          Layout.fillWidth: true
          text: card.station.name || ""
          color: card.current ? Theme.accentText : Theme.fg
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 1.18
          font.bold: true
          elide: Text.ElideRight
          textFormat: Text.PlainText
        }
        Text {
          Layout.fillWidth: true
          text: [Radio.flag(card.station.countrycode) + " " + (card.station.countrycode || ""),
                 card.station.codec, card.station.bitrate ? card.station.bitrate + " kbps" : ""].filter(s => s && s.trim()).join("  ·  ")
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.98
          elide: Text.ElideRight
          textFormat: Text.PlainText
        }
        Row {
          spacing: 4
          clip: true
          Layout.fillWidth: true
          Repeater {
            model: Radio.tags(card.station, 2)
            Rectangle {
              required property string modelData
              height: 16
              width: tagText.implicitWidth + 10
              radius: Theme.radius > 0 ? 8 : 0
              color: Qt.alpha(Theme.accent, 0.12)
              Text {
                id: tagText
                anchors.centerIn: parent
                text: parent.modelData
                color: Theme.accentText
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 0.85
                textFormat: Text.PlainText
              }
            }
          }
        }
      }

      Text {
        Layout.alignment: Qt.AlignTop
        text: card.favorite ? "★" : "☆"
        color: card.favorite ? Theme.warning : Theme.fgSubtle
        font.pixelSize: Theme.fontSize * 1.5
        opacity: card.favorite || hover.hovered ? 1 : 0
        Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 150 } }
        scale: starArea.pressed ? 0.8 : 1
        Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 5; damping: 0.3 } }
        MouseArea {
          id: starArea
          anchors.fill: parent
          anchors.margins: -6
          cursorShape: Qt.PointingHandCursor
          onClicked: Radio.favorite(card.station)
        }
      }
    }
  }

  HoverHandler { id: hover; cursorShape: Qt.PointingHandCursor }
  TapHandler { onTapped: card.play() }
}
